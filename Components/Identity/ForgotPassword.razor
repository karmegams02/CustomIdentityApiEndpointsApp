@page "/forgot-password"
@rendermode InteractiveServer
@using BlazorIdentityApiDemo.Data
@inject IJSRuntime JS
@implements IAsyncDisposable
<h3>ForgotPassword</h3>

<div>
    <label class="form-label">Email</label>
    <InputText @bind-Value="email" class="form-control"></InputText>
    <button class="btn btn-primary mt-2" @onclick="ForgotPasswordAsync">Send Password Reset Email</button>
</div>
<p> @message</p>

<a href="reset-password">Click to reset the password</a>
@code {
    public string email { get; set; } = string.Empty;
    private string message { get; set; } = string.Empty;
    private IJSObjectReference? browserApi;

    public async Task ForgotPasswordAsync()
    {
        try
        {
            browserApi ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/browser-auth.js");
            var result = await browserApi.InvokeAsync<BrowserApiResponse>(
                "send",
                "/forgotPassword",
                "POST",
                new { Email = email });

            message = result.IsSuccess
                ? "Password reset email sent successfully"
                : $"Forgot password request failed with status code: {result.Status}";
        }
        catch (JSException exception)
        {
            message = $"Forgot password request failed: {exception.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (browserApi is not null)
        {
            await browserApi.DisposeAsync();
        }
    }
}
