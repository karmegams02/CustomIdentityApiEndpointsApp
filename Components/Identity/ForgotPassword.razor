@page "/forgot-password"
@rendermode InteractiveServer
@inject HttpClient Http
<h3>ForgotPassword</h3>

<div>
    <label class="form-label">Email</label>
    <InputText @bind-Value="email" class="form-control"></InputText>
    <button class="btn btn-primary mt-2" @onclick="ForgotPasswordAsync">Send Password Reset Email</button>
</div>
<p> @message</p>

<a href="reset-password">Click to reset the password</a>
@code {
    public string email { get; set; }
    private string message { get; set; }
    public async Task ForgotPasswordAsync()
    {
        var result = await Http.PostAsJsonAsync("/forgotPassword", new { Email = email });
        if (!result.IsSuccessStatusCode)
        {
            message=$"Forgot password request failed with status code: {result.StatusCode}";
        }
        else
        {
            message = "Password reset email sent successfully";
        }
    }
}
