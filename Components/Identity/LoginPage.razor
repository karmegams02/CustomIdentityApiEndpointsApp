@page "/login-page"
@using BlazorIdentityApiDemo.Data
@inject HttpClient Http
@rendermode InteractiveServer
@inject TokenStore TokenStore
<h3>Login</h3>

<EditForm Model="@registerRequest" OnValidSubmit="@LoginSubmit" FormName="Login">
    <DataAnnotationsValidator />
    <div class="mb-4">
        <label class="form-label">Email</label>
        <InputText @bind-Value="registerRequest.Email" class="form-control"></InputText>
    </div>
    <div class="mb-4">
        <label class="form-label">Password</label>
        <InputText @bind-Value="registerRequest.Password" type="password" class="form-control"></InputText>
    </div>
    <ValidationMessage For="@(() => registerRequest.Email)" />
    <ValidationMessage For="@(() => registerRequest.Password)" />
    <div class="mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="useCookieAuthentication"></InputCheckbox>
        <label class="form-label">Use cookie authentication</label>
    </div>
    <button type="submit" class="btn btn-primary">Login</button>
</EditForm>
@if (!string.IsNullOrEmpty(statusMessage))
{
    <p class="text-success">@statusMessage</p>
}
@code {
    public bool useCookieAuthentication { get; set; }
    private LoginResponse loginResponse = new();
    public RegisterRequestDto registerRequest = new();
    public string statusMessage { get; set; }
    public async Task LoginSubmit()
    {
        var endpoint = useCookieAuthentication ? "/login?useCookies=true" : "/login";
        var result = await Http.PostAsJsonAsync(endpoint, new RegisterRequestDto()
        {
            Email = registerRequest.Email,
            Password = registerRequest.Password
        });
        if (!result.IsSuccessStatusCode)
        {
            statusMessage = "User login failed";
            var error=result.Content.ReadAsStringAsync().Result;
            Console.WriteLine($"Login failed with status code: {result.StatusCode}, error: {error}");
            return;
        }
        if (useCookieAuthentication)
        {
            statusMessage = "User logged in successfully with cookie authentication";
        }
        else
        {
            loginResponse = await result.Content.ReadFromJsonAsync<LoginResponse>();
            TokenStore.AccessToken =
loginResponse?.AccessToken;

            TokenStore.RefreshToken =
            loginResponse?.RefreshToken;
            statusMessage = "User logged in successfully with token authentication";
        }
        foreach (var h in result.Headers)
        {
            if (h.Key.Contains("Set-Cookie"))
            {
                Console.WriteLine(h.Value.FirstOrDefault());
            }
        }
    }
}
@if(!useCookieAuthentication && loginResponse is not null)
{
    <a href="/secure-data">Goto Secure data</a>
    <div class="mt-3">
        <p class="mt-4">AccessToken : </p>
        <textarea class="form-control">@loginResponse.AccessToken</textarea>
    </div>
    <div class="mt-3">
        <p class="mt-4">RefreshToken : </p>
        <textarea class="form-control">@loginResponse.RefreshToken</textarea>   
    </div>
}
