@page "/login-page"
@using BlazorIdentityApiDemo.Data
@rendermode InteractiveServer
@inject TokenStore TokenStore
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable
<h3>Login</h3>

<EditForm Model="@registerRequest" OnValidSubmit="@LoginSubmit" FormName="Login">
    <DataAnnotationsValidator />
    <div class="mb-4">
        <label class="form-label">Email</label>
        <InputText @bind-Value="registerRequest.Email" class="form-control"></InputText>
    </div>
    <div class="mb-4">
        <label class="form-label">Password</label>
        <InputText @bind-Value="registerRequest.Password" type="password" class="form-control"></InputText>
    </div>
    <ValidationMessage For="@(() => registerRequest.Email)" />
    <ValidationMessage For="@(() => registerRequest.Password)" />
    <div class="mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="useCookieAuthentication"></InputCheckbox>
        <label class="form-label">Use cookie authentication (required for authenticated pages)</label>
    </div>
    @if (requiresTwoFactor)
    {
        <div class="mb-4">
            <label class="form-label">Authenticator code</label>
            <InputText @bind-Value="twoFactorCode" class="form-control"></InputText>
        </div>
        <div class="mb-4">
            <label class="form-label">Recovery code</label>
            <InputText @bind-Value="twoFactorRecoveryCode" class="form-control"></InputText>
            <div class="form-text">Enter either an authenticator code or a recovery code.</div>
        </div>
    }
    <button type="submit" class="btn btn-primary">Login</button>
</EditForm>
<a href="/enable-2fa">Enable two factor authentication</a>
<br />
<a href="/forgot-password">Forgot Password?</a>
<br />
@if (!string.IsNullOrEmpty(statusMessage))
{
    <p class="text-success">@statusMessage</p>
}
@code {
    public bool useCookieAuthentication { get; set; } = true;
    private LoginResponse loginResponse = new();
    private IJSObjectReference? browserAuth;
    private bool requiresTwoFactor;
    private string twoFactorCode = string.Empty;
    private string twoFactorRecoveryCode = string.Empty;
    public RegisterRequestDto registerRequest = new();
    public string statusMessage { get; set; } = string.Empty;

    public async Task LoginSubmit()
    {
        try
        {
            browserAuth ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/browser-auth.js");
            var endpoint = useCookieAuthentication ? "/login?useCookies=true" : "/login";
            var result = await browserAuth.InvokeAsync<BrowserApiResponse>("send", endpoint, "POST", new
            {
                Email = registerRequest.Email,
                Password = registerRequest.Password,
                TwoFactorCode = string.IsNullOrWhiteSpace(twoFactorCode) ? null : twoFactorCode,
                TwoFactorRecoveryCode = string.IsNullOrWhiteSpace(twoFactorRecoveryCode)
                    ? null
                    : twoFactorRecoveryCode
            });

            if (!result.IsSuccess)
            {
                if (result.Status == StatusCodes.Status401Unauthorized &&
                    result.Body.Contains("RequiresTwoFactor", StringComparison.Ordinal))
                {
                    requiresTwoFactor = true;
                    statusMessage = "Enter the code from your authenticator app or a recovery code.";
                    return;
                }

                statusMessage = $"User login failed with status code: {result.Status}. {result.Body}";
                return;
            }

            if (useCookieAuthentication)
            {
                Navigation.NavigateTo("/auth-test", forceLoad: true);
                return;
            }

            loginResponse = result.ReadJson<LoginResponse>() ?? new LoginResponse();
            TokenStore.AccessToken = loginResponse.AccessToken;
            TokenStore.RefreshToken = loginResponse.RefreshToken;
            statusMessage = "User logged in successfully with token authentication";
        }
        catch (JSException exception)
        {
            statusMessage = $"User login failed: {exception.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (browserAuth is not null)
        {
            await browserAuth.DisposeAsync();
        }
    }
}
<br />
@if(!useCookieAuthentication && loginResponse is not null)
{
    <a href="/secure-data">Goto Secure data</a>
    <div class="mt-3">
        <p class="mt-4">AccessToken : </p>
        <textarea class="form-control">@loginResponse.AccessToken</textarea>
    </div>
    <div class="mt-3">
        <p class="mt-4">RefreshToken : </p>
        <textarea class="form-control">@loginResponse.RefreshToken</textarea>
    </div>
}
