@page "/resend-confirmation-email"
@rendermode InteractiveServer
@using BlazorIdentityApiDemo.Data
@inject IJSRuntime JS
@implements IAsyncDisposable
<h3>Resend Confirmation Email</h3>

<div>
    <label class="form-label">Email</label>
    <InputText @bind-Value="email" class="form-control"></InputText>
    <button class="btn btn-primary mt-2" @onclick="ResendConfirmationEmailAsync">Resend Confirmation Email</button>
</div>
<p> @message</p>
@code{
    public string email { get; set; } = string.Empty;
    private string message { get; set; } = string.Empty;
    private IJSObjectReference? browserApi;

    public async Task ResendConfirmationEmailAsync()
    {
        try
        {
            browserApi ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/browser-auth.js");
            var result = await browserApi.InvokeAsync<BrowserApiResponse>(
                "send",
                "/resendConfirmationEmail",
                "POST",
                new { Email = email });

            message = result.IsSuccess
                ? "Confirmation email resent successfully"
                : $"Resend confirmation email failed with status code: {result.Status}";
        }
        catch (JSException exception)
        {
            message = $"Resend confirmation email failed: {exception.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (browserApi is not null)
        {
            await browserApi.DisposeAsync();
        }
    }
}