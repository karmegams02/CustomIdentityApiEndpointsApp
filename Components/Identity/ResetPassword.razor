@page "/reset-password"
@rendermode InteractiveServer
@using BlazorIdentityApiDemo.Data
@inject IJSRuntime JS
@implements IAsyncDisposable

<h3>Reset Password</h3>

<div class="mb-3">
    <label class="form-label">Email</label>
    <InputText @bind-Value="email" class="form-control"></InputText>
    </div>
    <div class="mb-3">
        <label class="form-control">Reset Code
        </label>
        <InputText class="form-control" @bind-Value="resetCode"></InputText>
    </div>
<div class="mb-3">
    <label class="form-control">
        New password
    </label>
    <InputText class="form-control" @bind-Value="newPassword"></InputText>
</div>
    <button type="submit" class="form-control" @onclick="ResetPasswordAsync">Reset password</button>
<p>@message</p>
@code{
private string email { get; set; } = string.Empty;
private string resetCode { get; set; } = string.Empty;
private string newPassword { get; set; } = string.Empty;
private string message { get; set; } = string.Empty;
private IJSObjectReference? browserApi;

private async Task ResetPasswordAsync()
{
    try
    {
        browserApi ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/browser-auth.js");
        var result = await browserApi.InvokeAsync<BrowserApiResponse>(
            "send",
            "/resetPassword",
            "POST",
            new { Email = email, ResetCode = resetCode, NewPassword = newPassword });

        message = result.IsSuccess
            ? "Password reset successfully"
            : $"Reset password request failed with status code: {result.Status}";
    }
    catch (JSException exception)
    {
        message = $"Reset password request failed: {exception.Message}";
    }
}

public async ValueTask DisposeAsync()
{
    if (browserApi is not null)
    {
        await browserApi.DisposeAsync();
    }
}
}