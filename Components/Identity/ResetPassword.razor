@page "/reset-password"
@rendermode InteractiveServer
@inject HttpClient Http

<h3>Reset Password</h3>

<div class="mb-3">
    <label class="form-label">Email</label>
    <InputText @bind-Value="email" class="form-control"></InputText>
    </div>
    <div class="mb-3">
        <label class="form-control">Reset Code
        </label>
        <InputText class="form-control" @bind-Value="resetCode"></InputText>
    </div>
<div class="mb-3">
    <label class="form-control">
        New password
    </label>
    <InputText class="form-control" @bind-Value="newPassword"></InputText>
</div>
    <button type="submit" class="form-control" @onclick="ResetPasswordAsync">Reset password</button>
@code{
    private string email { get; set; }
    private string resetCode { get; set; }
    private string newPassword { get; set; }

    private async Task ResetPasswordAsync()
    {
        var result = await Http.PostAsJsonAsync("/resetPassword", new { Email = email, ResetCode = resetCode, NewPassword=newPassword });
        if (!result.IsSuccessStatusCode)
        {
            Console.WriteLine($"Reset password request failed with status code: {result.StatusCode}");
        }
        else
        {
            Console.WriteLine("Password reset successfully");
        }
    }
}