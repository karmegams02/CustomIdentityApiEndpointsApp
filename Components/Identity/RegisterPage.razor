@page "/register-page"
@using System.ComponentModel.DataAnnotations
@using BlazorIdentityApiDemo.Data
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable
<h3>Register</h3>

<EditForm Model="@registerRequest" OnValidSubmit="@RegisterSubmit" FormName="Register">
   <DataAnnotationsValidator/>
    <div class="mb-4">
        <label class="form-label">Email</label>
        <InputText @bind-Value="registerRequest.Email" class="form-control"></InputText>
    </div>
    <div class="mb-4">
        <label class="form-label">Password</label>
        <InputText @bind-Value="registerRequest.Password" type="password" class="form-control"></InputText>
    </div>
    <ValidationMessage For="@(() => registerRequest.Email)" />
    <ValidationMessage For="@(() => registerRequest.Password)" />
    <button type="submit" class="btn btn-primary">Register</button>
</EditForm>
@if (!string.IsNullOrEmpty(statusMessage))
{
    <p class="text-success">@statusMessage</p>
}
@code {

    public RegisterRequestDto registerRequest = new();
    public string statusMessage { get; set; } = string.Empty;
    private IJSObjectReference? browserApi;

    public async Task RegisterSubmit()
    {
        try
        {
            browserApi ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/browser-auth.js");
            var result = await browserApi.InvokeAsync<BrowserApiResponse>("send", "/register", "POST", new
            {
                Email = registerRequest.Email,
                Password = registerRequest.Password
            });

            statusMessage = result.IsSuccess
                ? "User registered successfully"
                : $"User registration failed with status code: {result.Status}";
        }
        catch (JSException exception)
        {
            statusMessage = $"User registration failed: {exception.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (browserApi is not null)
        {
            await browserApi.DisposeAsync();
        }
    }
}