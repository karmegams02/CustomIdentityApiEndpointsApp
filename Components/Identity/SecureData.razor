@page "/secure-data"
@using BlazorIdentityApiDemo.Data
@using Microsoft.AspNetCore.Identity.Data
@inject TokenStore TokenStore
@inject HttpClient Http
@rendermode InteractiveServer
<h3>SecureData</h3>

<button class="btn btn-primary" onclick="@GetSecureData">Get secure Data</button>
@if(message is not null)
{
<p>@message</p>
}

<button class="btn btn-warning"
        @onclick="RefreshToken">
    Refresh Token
</button>
@code {
    private string message = string.Empty;
    public async Task GetSecureData()
    {
        var request = new HttpRequestMessage(HttpMethod.Get, "secure-info");
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenStore.AccessToken);
        var response = await Http.SendAsync(request);
        message = await response.Content.ReadAsStringAsync();
    }
    public async Task RefreshToken()
    {
        var request =await Http.PostAsJsonAsync("/refresh", new RefreshRequest()
        {
            RefreshToken = TokenStore.RefreshToken
        });
        if (!request.IsSuccessStatusCode)
        {
            message = "Token refresh failed";
            return;
        }
        else
        {
            var refreshResponse = request.Content.ReadFromJsonAsync<LoginResponse>();
            if (refreshResponse.IsCompletedSuccessfully)
            {
                TokenStore.AccessToken = refreshResponse.Result.AccessToken;
                TokenStore.RefreshToken = refreshResponse.Result.RefreshToken;
            }
        }
       
    }
}
<p>Access token: @TokenStore.AccessToken</p>
<p>RefreshToken: @TokenStore.RefreshToken</p>