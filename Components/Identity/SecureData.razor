@page "/secure-data"
@using BlazorIdentityApiDemo.Data
@inject TokenStore TokenStore
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable
<h3>SecureData</h3>

<button class="btn btn-primary" @onclick="GetSecureData">Get secure Data</button>
@if(message is not null)
{
<p>@message</p>
}

<button class="btn btn-warning"
        @onclick="RefreshToken">
    Refresh Token
</button>
@code {
    private string message = string.Empty;
    private IJSObjectReference? browserApi;

    public async Task GetSecureData()
    {
        try
        {
            browserApi ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/browser-auth.js");
            var response = await browserApi.InvokeAsync<BrowserApiResponse>(
                "send",
                "/secure-info",
                "GET",
                null,
                TokenStore.AccessToken);

            message = response.Body;
        }
        catch (JSException exception)
        {
            message = $"Loading secure data failed: {exception.Message}";
        }
    }

    public async Task RefreshToken()
    {
        try
        {
            browserApi ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/browser-auth.js");
            var response = await browserApi.InvokeAsync<BrowserApiResponse>(
                "send",
                "/refresh",
                "POST",
                new { RefreshToken = TokenStore.RefreshToken });

            if (!response.IsSuccess)
            {
                message = $"Token refresh failed with status code: {response.Status}";
                return;
            }

            var loginResponse = response.ReadJson<LoginResponse>();
            if (loginResponse is not null)
            {
                TokenStore.AccessToken = loginResponse.AccessToken;
                TokenStore.RefreshToken = loginResponse.RefreshToken;
                message = "Token refreshed successfully";
            }
        }
        catch (JSException exception)
        {
            message = $"Token refresh failed: {exception.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (browserApi is not null)
        {
            await browserApi.DisposeAsync();
        }
    }
}
<p>Access token: @TokenStore.AccessToken</p>
<p>RefreshToken: @TokenStore.RefreshToken</p>